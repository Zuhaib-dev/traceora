{
  "name": "@traceora/node",
  "version": "0.4.1",
  "description": "Shared Node.js instrumentation (AsyncLocalStorage, Prisma, Mongoose) for Traceora",
  "author": {
    "name": "Zuhaib Rashid",
    "url": "https://zuhaibrashid.com",
    "email": "zuhaibrashid01@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/zuhaib-dev/traceora.git",
    "directory": "packages/node"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@traceora/core": "workspace:*"
  },
  "peerDependencies": {
    "@prisma/client": "^5.0.0",
    "mongoose": "^8.0.0"
  },
  "peerDependenciesMeta": {
    "@prisma/client": {
      "optional": true
    },
    "mongoose": {
      "optional": true
    }
  },
  "devDependencies": {
    "tsup": "^8.0.2",
    "typescript": "^5.3.3"
  },
  "keywords": [
    "traceora",
    "node",
    "backend",
    "prisma",
    "mongoose",
    "telemetry",
    "tracing",
    "observability",
    "devtools"
  ],
  "bugs": {
    "url": "https://github.com/zuhaib-dev/traceora/issues"
  },
  "homepage": "https://traceora-web.vercel.app/",
  "license": "MIT"
}
