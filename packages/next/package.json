{
  "name": "@traceora/next",
  "version": "0.1.8",
  "description": "Next.js App Router instrumentation for Traceora",
  "author": {
    "name": "Zuhaib Rashid",
    "url": "https://zuhaibrashid.com",
    "email": "zuhaibrashid01@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/zuhaib-dev/traceora.git",
    "directory": "packages/next"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./client": {
      "import": "./dist/client.mjs",
      "require": "./dist/client.js",
      "types": "./dist/client.d.ts"
    }
  },
  "files": [
    "dist",
    "logo.svg"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@traceora/core": "workspace:*",
    "@traceora/react": "workspace:*"
  },
  "peerDependencies": {
    "next": "^13.0.0 || ^14.0.0 || ^15.0.0 || ^16.0.0",
    "react": "^18.0.0 || ^19.0.0"
  },
  "keywords": [
    "traceora",
    "nextjs",
    "next",
    "react",
    "telemetry",
    "tracing",
    "observability",
    "app-router",
    "server-actions",
    "performance"
  ],
  "homepage": "https://traceora-web.vercel.app/",
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0"
  }
}
