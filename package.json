{
  "name": "traceora-workspace",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "author": {
    "name": "Zuhaib Rashid",
    "url": "https://zuhaibrashid.com",
    "email": "hello@zuhaibrashid.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/zuhaib-dev/traceora.git"
  },
  "scripts": {
    "build": "pnpm --filter \"./packages/**\" build",
    "dev": "pnpm --filter \"./packages/**\" dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "clean": "pnpm --filter \"./packages/**\" run clean"
  },
  "devDependencies": {
    "@babel/preset-typescript": "^8.0.1",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.2.5",
    "tsup": "^8.0.2",
    "typescript": "^5.3.3",
    "vitest": "^1.3.1"
  },
  "license": "MIT",
  "keywords": [
    "traceora",
    "react",
    "vite",
    "telemetry",
    "tracing",
    "devtools",
    "observability",
    "performance",
    "monitoring",
    "error-tracking"
  ],
  "bugs": {
    "url": "https://github.com/zuhaib-dev/traceora/issues"
  },
  "homepage": "https://github.com/zuhaib-dev/traceora#readme"
}
